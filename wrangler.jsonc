{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plataforma-pesquisa-clinica",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "pesquisa-clinica-uepg"
    }
  ]
}
