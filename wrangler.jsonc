{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_SECRET": "uepg-pesquisa-clinica-secret-jwt-key-2026"
  }
}
