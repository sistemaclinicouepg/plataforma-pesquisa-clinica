generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String          @id @default(uuid())
  name       String
  email      String          @unique
  password   String
  role       String          @default("RESEARCHER")
  isApproved Boolean         @default(false)
  createdAt  DateTime        @default(now())
  projects   ProjectMember[]
}

model Patient {
  id             String        @id @default(uuid())
  fullName       String
  cpf            String        @unique
  email          String?
  phoneWhatsApp  String
  address        String?
  dateOfBirth    DateTime
  biologicalSex  String
  comorbidities  String?
  allergies      String?
  medications    String?
  chiefComplaint String?
  expectations   String?
  createdAt      DateTime      @default(now())
  participations Participant[]
}

model Project {
  id                String          @id @default(uuid())
  name              String
  description       String?
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  anamnesisTemplate String?
  auditLogs         AuditLog[]
  alerts            ClinicalAlert[]
  consentForm       ConsentForm?
  forms             Form[]
  participants      Participant[]
  members           ProjectMember[]
}

model ProjectMember {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  role      String  @default("OPERATOR")
  isBlinded Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@index([projectId], map: "idx_projectmember_project")
  @@index([userId], map: "idx_projectmember_user")
}

model Participant {
  id              String             @id @default(uuid())
  patientId       String
  projectId       String
  researchCode    String
  status          String             @default("PENDING")
  exclusionReason String?
  group           String?
  anamnesisDone   Boolean            @default(false)
  anamnesisData   String?
  createdAt       DateTime           @default(now())
  alerts          ClinicalAlert[]
  sessions        ClinicalSession[]
  signatures      ConsentSignature[]
  responses       FormResponse[]
  patient         Patient            @relation(fields: [patientId], references: [id])
  project         Project            @relation(fields: [projectId], references: [id])

  @@unique([projectId, researchCode])
  @@index([patientId], map: "idx_participant_patient")
  @@index([projectId], map: "idx_participant_project")
  @@index([status], map: "idx_participant_status")
}

model ConsentForm {
  id                    String             @id @default(uuid())
  projectId             String             @unique
  title                 String
  responsibleResearcher String
  advisor               String?
  institution           String             @default("Universidade Estadual de Ponta Grossa – UEPG")
  ethicsNumber          String?
  ethicsContacts        String?
  contentMarkdown       String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  assentContentMarkdown String?
  project               Project            @relation(fields: [projectId], references: [id])
  signatures            ConsentSignature[]
}

model ConsentSignature {
  id                    String      @id @default(uuid())
  consentFormId         String
  participantId         String
  participantName       String
  cpf                   String
  signatureData         String
  ipAddress             String?
  userAgent             String?
  signedAt              DateTime    @default(now())
  guardianCpf           String?
  guardianName          String?
  guardianRelationship  String?
  guardianSignatureData String?
  isAssent              Boolean     @default(false)
  signatureHash         String?
  consentForm           ConsentForm @relation(fields: [consentFormId], references: [id])
  participant           Participant @relation(fields: [participantId], references: [id])

  @@index([consentFormId], map: "idx_consentsignature_form")
  @@index([participantId], map: "idx_consentsignature_participant")
}

model Form {
  id              String         @id @default(uuid())
  projectId       String
  title           String
  description     String?
  questionsJson   String
  expirationHours Int            @default(24)
  allowLate       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  project         Project        @relation(fields: [projectId], references: [id])
  responses       FormResponse[]
}

model FormResponse {
  id            String       @id @default(uuid())
  formId        String
  participantId String?
  answersJson   String
  signatureData String?
  isLate        Boolean      @default(false)
  submittedAt   DateTime     @default(now())
  form          Form         @relation(fields: [formId], references: [id])
  participant   Participant? @relation(fields: [participantId], references: [id])

  @@index([formId], map: "idx_formresponse_form")
  @@index([participantId], map: "idx_formresponse_participant")
}

model ClinicalSession {
  id                 String          @id @default(uuid())
  participantId      String
  sessionNumber      Int
  sessionType        String
  sessionDate        DateTime        @default(now())
  shadeRight         String?
  shadeLeft          String?
  painScore0h        Float?
  painScore1h        Float?
  painScore24h       Float?
  painScore48h       Float?
  gingivalIrritation String?
  adverseEvents      String?
  operatorName       String?
  evaluatorName      String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  alerts             ClinicalAlert[]
  participant        Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([sessionNumber], map: "idx_clinicalsession_number")
  @@index([participantId], map: "idx_clinicalsession_participant")
}

model ClinicalAlert {
  id                String           @id @default(uuid())
  projectId         String
  participantId     String
  sessionId         String?
  severity          String           @default("SEVERE")
  alertType         String
  painScore         Float?
  gingivalSensation String?
  timePoint         String?
  description       String
  status            String           @default("PENDING")
  resolvedAt        DateTime?
  resolvedBy        String?
  resolutionNotes   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  participant       Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session           ClinicalSession? @relation(fields: [sessionId], references: [id])

  @@index([participantId], map: "idx_clinicalalert_participant")
  @@index([projectId], map: "idx_clinicalalert_project")
}

model AuditLog {
  id         String   @id @default(uuid())
  projectId  String?
  entityType String
  entityId   String
  action     String
  changedBy  String
  userEmail  String?
  fieldName  String?
  oldValue   String?
  newValue   String?
  reason     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)], map: "idx_auditlog_created")
  @@index([entityType, entityId], map: "idx_auditlog_entity")
  @@index([projectId], map: "idx_auditlog_project")
}
